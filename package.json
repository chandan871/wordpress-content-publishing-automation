{
  "name": "wordpress-content-publishing-automation",
  "private": true,
  "type": "module",
  "scripts": {
    "check:wp": "node scripts/kahaniworld-phase2-publisher.mjs --check-wp",
    "check:sheet": "node scripts/kahaniworld-phase2-publisher.mjs --check-sheet",
    "dry-run": "node scripts/kahaniworld-phase2-publisher.mjs --dry-run --limit 1",
